# .env.example — Documented environment variable template.
#
# Copy this file to `.env` and edit the values for your local environment:
#
#     cp .env.example .env
#
# `.env` is gitignored; never commit secrets. `python-dotenv` (pinned in
# requirements.txt at version 1.1.1) loads `.env` automatically when the
# Flask CLI starts and when `wsgi.py` calls `load_dotenv()`.
#
# Variable names are preserved 1:1 from the original Node.js project, so
# existing deployment manifests (Docker Compose, Helm values, Kubernetes
# ConfigMaps, etc.) continue to work unchanged.

# --- Flask core configuration ---
# Selects the Config subclass loaded by app.create_app(). One of:
# 'development' (DEBUG=True, verbose logs), 'testing' (TESTING=True, in-memory
# DB), 'production' (DEBUG=False, structured JSON logs). Default: 'production'.
FLASK_CONFIG=development

# Enables the interactive debugger and reloader. Set to 0 in production.
# Overridden by .flaskenv during `flask run`. Default: 0.
FLASK_DEBUG=1

# Module:callable that the Flask CLI uses to discover the application.
# Set in .flaskenv; included here for completeness. Default: 'wsgi:app'.
FLASK_APP=wsgi:app

# --- HTTP server bind ---
# Bind address for the development server (`flask run`) and the production
# server (`gunicorn`). Use 127.0.0.1 for local development, 0.0.0.0 for
# containerized production. Default: 127.0.0.1.
HOST=127.0.0.1

# Bind port. Must match the port any reverse proxy or load balancer is
# forwarding to. Default: 5000.
PORT=5000

# Number of gunicorn worker processes (production only). A common rule is
# (2 * CPU_count) + 1. Default: 4.
WEB_CONCURRENCY=4

# --- Security ---
# Secret used by Flask sessions, itsdangerous-signed cookies, and any
# signed-token logic. MUST be a cryptographically strong random string in
# production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production; do not deploy without setting this.
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of trusted proxy hops (used by Werkzeug ProxyFix
# when wrapping app.wsgi_app). Set to 1 if behind a single reverse proxy
# (nginx, traefik, ELB), 2 if behind two (e.g., CloudFront -> ALB). Default: 0.
TRUSTED_PROXY_COUNT=0

# --- Logging ---
# Python logging level for the application logger. One of:
# 'CRITICAL', 'ERROR', 'WARNING', 'INFO', 'DEBUG'. Default: 'INFO'.
LOG_LEVEL=INFO

# Log output format. 'plain' for human-readable, 'json' for machine-parseable
# (consumed by ELK, Datadog, CloudWatch, etc.). Default: 'plain' in dev,
# 'json' in production.
LOG_FORMAT=plain

# --- Application-specific variables ---
# The variables below are placeholders for values that the original Node.js
# source will require once it is supplied. Each will be populated 1:1 from
# the Node `.env.example` (preserving names and example values) per AAP
# Section 0.5.1.2 Part B.
#
# Example placeholders (commented out — uncomment and fill when source arrives):
#
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379/0
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# JWT_SECRET=change-me
# JWT_ALGORITHM=HS256
# JWT_EXPIRES_SECONDS=3600
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
